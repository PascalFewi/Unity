{
  "steps": ["field_crossings", "segmentation", "depth", "check_images"],

  "field": {
    "layout": "data/field_layout.json",
    "ground_y": 0.5
  },

  "field_crossings": {
    "box_fraction": 0.04,
    "cover_window_px": 7,
    "max_covered_fraction": 0.5,
    "replace_labels": ["L-Intersection", "T-Intersection", "X-Intersection"]
  },

  "segmentation": {
    "line_label": "field_line",
    "line_color": [255, 255, 255],
    "remove_labels": ["L-Intersection", "T-Intersection", "X-Intersection"],
    "circle_segments": 96
  },

  "depth": {
    "clip_percent": 1
  },

  "checks": {
    "max_images": 24
  }
}
